{
  "manifest_version": 3,
  "name": "淘股吧摸鱼",
  "version": "1.0.0",
  "description": "隐藏淘股吧的导航栏、标题栏、侧边栏，透明化和缩小图片",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.tgb.cn/*",
    "http://www.tgb.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tgb.cn/*",
        "http://www.tgb.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "淘股吧摸鱼"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
